{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Replaces Minecraft's Anvil region files with a custom bucket-based format compressed by zstd — smaller saves, faster chunk IO.",
  "authors": [
    "${mod_author}"
  ],
  "license": "${mod_license}",
  "contact": {
    "homepage": "https://github.com/tqk114514/Chunk-Storage-Optimizer",
    "issues": "https://github.com/tqk114514/Chunk-Storage-Optimizer/issues"
  },
  "icon": "assets/chunkstorageoptimizer/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "tqk114514.chunkstorageoptimizer.ChunkStorageOptimizerFabric"
    ],
    "modmenu": [
      "tqk114514.chunkstorageoptimizer.CsoModMenuIntegration"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "java": ">=${java_level}",
    "fabric-api": "*"
  }
}
